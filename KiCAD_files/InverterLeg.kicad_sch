		(uuid "9e688e55-65c5-440e-81c7-19d7c0980acf")
	)
	(text "DT (in ns) = 10 × R_{DT} (in kΩ).\nTI recommends bypassing this pin with\na ceramic capacitor, 2.2 nF or greater.\nSo with DT = @{10*(${/8d0c1d66-35ef-4a53-a28f-436a11b54f42/532bac1e-414d-4f10-8c4a-d2334bc02fa5:Value}/1000)}nS"
		(exclude_from_sim no)
		(at 163.83 221.488 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "a6758181-a848-483d-813f-9242538f4d92")
	)
	(text "UCC21520A Variant has lower UVLO\non VDD permitting compatibility \nwith GanFets"
